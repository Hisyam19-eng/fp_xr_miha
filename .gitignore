# =========================================================================
# Unity .gitignore standard (GitHub Official + Best Practices)
# =========================================================================

# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from the github/gitignore repository:
# https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Never commit: Library/, Temp/, Obj/, Build/, BuildsGPUTests/, MemoryCaptures/
# Always commit: Assets/, Packages/, ProjectSettings/ (including all .meta files!)

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset server cache
/[Aa]sset_Server_Cache/

# Auto-generated VS/Rider/MonoDevelop project and solution files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Unity3D generated meta files for ignored folders
/[Ll]ibrary.meta
/[Tt]emp.meta
/[Oo]bj.meta
/[Bb]uild.meta
/[Bb]uilds.meta
/[Ll]ogs.meta
/[Uu]ser[Ss]ettings.meta

# Visual Studio / Rider / VSCode caches
.vs/
.idea/
.vscode/
*.private
*.private.meta

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Crashlytics
crashlytics-build.properties

# Course brief repo (separate git repo, not part of the project)
/giga-ea234505-2026-final-project-group-3/

# Unity 6 Android CMake/Gradle temporary build cache (contains local paths)
/.utmp/
/.utmp.meta

# Local device configuration (contains headset serial number & hardware snapshot)
/config.json

# Build artifacts, packages & shipping exclusions
*.apk
*.aab
*.unitypackage
*.app
*.provenance.json
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
/Data/Plugins/

# Signing keys, credentials & environment secrets (never commit to public repos)
*.keystore
*.jks
*.p12
*.pem
*.key
.env
.env.*
local.properties
google-services.json
GoogleService-Info.plist

# Logs, test reports & crash dumps
*.log
test-results*.xml
test-results*.json
sysinfo.txt
*.stackdump
